{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "spendguard.finos.org/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "SpendPolicy"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "owner": {
          "type": "string"
        },
        "approvedBy": {
          "type": "string"
        },
        "effectiveFrom": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "currency": {
          "type": "string",
          "const": "USD"
        }
      },
      "required": [
        "name",
        "version",
        "owner",
        "approvedBy",
        "effectiveFrom",
        "currency"
      ],
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "properties": {
        "llm": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "inputPer1kTokens": {
                "type": "number",
                "minimum": 0
              },
              "outputPer1kTokens": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "inputPer1kTokens",
              "outputPer1kTokens"
            ],
            "additionalProperties": false
          }
        },
        "services": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "unitPrice": {
                "type": "number",
                "minimum": 0
              },
              "vendor": {
                "type": "string"
              }
            },
            "required": [
              "unitPrice",
              "vendor"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "llm",
        "services"
      ],
      "additionalProperties": false
    },
    "authorityTiers": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "autoApproveUpTo": {
            "type": "number",
            "minimum": 0
          },
          "escalateUpTo": {
            "type": "number",
            "minimum": 0
          },
          "fourEyesAbove": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "approverRoles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "label",
          "autoApproveUpTo",
          "escalateUpTo",
          "fourEyesAbove",
          "approverRoles"
        ],
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          },
          "budgets": {
            "type": "object",
            "properties": {
              "perCase": {
                "type": "number",
                "minimum": 0
              },
              "perDay": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "perCase",
              "perDay"
            ],
            "additionalProperties": false
          },
          "allowedServices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "canDelegateTo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "description",
          "tier",
          "budgets",
          "allowedServices",
          "canDelegateTo"
        ],
        "additionalProperties": false
      }
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "delegation": {
      "type": "object",
      "properties": {
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "defaultTtlMinutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "maxDepth",
        "defaultTtlMinutes"
      ],
      "additionalProperties": false
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "service_allowlist",
              "budget",
              "doa_threshold",
              "four_eyes",
              "structuring",
              "delegation",
              "runaway",
              "duplicate",
              "audit"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "deny",
              "escalate",
              "deny_and_suspend"
            ]
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "aigf": {
            "type": "object",
            "properties": {
              "risks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mitigations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "risks",
              "mitigations"
            ],
            "additionalProperties": false
          },
          "ccc": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "enabled",
          "action",
          "aigf",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "pricing",
    "authorityTiers",
    "agents",
    "approvers",
    "delegation",
    "controls"
  ],
  "additionalProperties": false
}
